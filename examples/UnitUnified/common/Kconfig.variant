# Shared "Target unit / board" selection for the M5Unit-FINGER UnitUnified examples (ESP-IDF).
# rsource'd from each example's main/Kconfig.projbuild. The chosen CONFIG_EXAMPLE_USING_* is mapped
# to the source-level USING_* macro in common/variant.cmake (shared with the Arduino build).
menu "M5Unit-FINGER example"

choice EXAMPLE_FINGER_VARIANT
    prompt "Target unit / board"
    default EXAMPLE_USING_UNIT_FINGER
    help
        Which fingerprint unit / board this example drives.

    config EXAMPLE_USING_UNIT_FINGER
        bool "UnitFinger (FPC1020A, UART / GROVE PortC)"
    config EXAMPLE_USING_HAT_FINGER
        bool "HatFinger (FPC1020A, UART / HAT)"
    config EXAMPLE_USING_FACES_FINGER
        bool "FacesFinger (FPC1020A, UART / M-Bus)"
endchoice

endmenu
